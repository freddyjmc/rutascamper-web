---
// Paisaje de la portada en capas: cada .layer se desplaza a distinta velocidad al hacer scroll (--k).
// Los colores salen de variables CSS: de día en modo claro y de noche en modo oscuro.
---
<div class="scene-wrap" aria-hidden="true">
<svg class="scene" viewBox="0 0 1440 480" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sc-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--sea-1)" />
      <stop offset="1" style="stop-color: var(--sea-2)" />
    </linearGradient>
  </defs>

  <g class="layer" style="--k: .5">
    <circle class="sun" cx="1010" cy="170" r="110" fill="var(--sun)" opacity=".16" />
    <circle class="sun" cx="1010" cy="170" r="66" fill="var(--sun)" />
  </g>

  <g class="layer" style="--k: .42">
    <g class="cloud" fill="var(--cloud)" opacity=".9">
      <ellipse cx="260" cy="104" rx="56" ry="15" />
      <ellipse cx="294" cy="92" rx="34" ry="16" />
    </g>
    <g class="cloud b" fill="var(--cloud)" opacity=".75">
      <ellipse cx="1000" cy="70" rx="44" ry="11" />
      <ellipse cx="1026" cy="61" rx="26" ry="12" />
    </g>
  </g>

  <g class="layer" style="--k: .3">
    <path d="M0 230 L140 140 L250 200 L380 90 L500 190 L600 150 L740 220 L860 110 L980 200 L1100 160 L1230 230 L1340 130 L1440 190 V480 H0Z" fill="var(--mtn-far)" />
    <g fill="var(--snow)" opacity=".9">
      <path d="M380 90 L404 113 L391 117 L379 109 L364 115Z" />
      <path d="M860 110 L882 131 L869 134 L858 127 L845 132Z" />
      <path d="M1340 130 L1360 149 L1348 152 L1338 146 L1326 150Z" />
    </g>
  </g>

  <g class="layer" style="--k: .18">
    <path d="M0 280 C160 220 300 240 420 262 C580 292 700 220 880 240 C1060 260 1180 220 1320 250 C1390 262 1420 258 1440 255 V480 H0Z" fill="var(--mtn-near)" />
    <g fill="var(--tree)">
      <path d="M150 250 l12 -34 l12 34z" /><path d="M176 252 l9 -26 l9 26z" /><path d="M200 248 l11 -30 l11 30z" />
      <path d="M940 246 l12 -34 l12 34z" /><path d="M966 250 l9 -24 l9 24z" />
      <path d="M1210 240 l11 -30 l11 30z" /><path d="M1236 244 l9 -24 l9 24z" /><path d="M1258 246 l10 -28 l10 28z" />
    </g>
  </g>

  <g class="layer" style="--k: .08">
    <rect y="296" width="1440" height="184" fill="url(#sc-sea)" />
    <g class="waves" stroke="#ffffff" stroke-width="3" stroke-linecap="round" fill="none" opacity=".4">
      <path d="M-30 322 q15 -8 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0" />
      <path d="M0 350 q15 -8 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0" />
    </g>
  </g>

  <g>
    <path d="M0 400 C320 380 760 392 1440 362 V480 H0Z" fill="var(--bg)" />
    <path d="M0 428 C360 410 760 420 1440 390" stroke="var(--road)" stroke-width="58" fill="none" />
    <path d="M0 428 C360 410 760 420 1440 390" stroke="#ffffff" stroke-width="3" stroke-dasharray="22 18" fill="none" opacity=".7" />
    <!-- La posición y la escala del camper van en el grupo externo (CSS, por tamaño de pantalla); la animación usa translate en el interior. -->
    <g class="rig" transform="translate(880 265) rotate(-1.5) scale(2.4)">
      <g class="drive">
        <g class="smoke"><circle cx="-6" cy="58" r="7" /><circle cx="-6" cy="58" r="7" /><circle cx="-6" cy="58" r="7" /></g>
        <ellipse class="shadow" cx="64" cy="69" rx="68" ry="4" />
        <g class="camper">
          <rect x="0" y="12" width="92" height="44" rx="12" fill="#ffffff" />
          <rect x="0" y="12" width="92" height="16" rx="10" fill="#ec7a3a" />
          <path d="M92 26 h20 l14 18 v12 h-34z" fill="#ffffff" />
          <path d="M96 30 h14 l9 12 h-23z" fill="#bfe6e6" />
          <rect x="10" y="32" width="22" height="13" rx="3" fill="#bfe6e6" />
          <rect x="38" y="32" width="22" height="13" rx="3" fill="#bfe6e6" />
          <rect x="66" y="30" width="18" height="24" rx="3" fill="#0b6e78" opacity=".2" />
          <rect x="14" y="2" width="56" height="10" rx="4" fill="#0b6e78" />
          <circle cx="121" cy="48" r="2.5" fill="#ffd08a" />
          <g class="wheel"><circle cx="24" cy="58" r="10" fill="#14232a" /><circle cx="24" cy="58" r="4.5" fill="#d9d9d9" /><path d="M24 53.5v9M19.5 58h9" stroke="#14232a" stroke-width="1.6" /></g>
          <g class="wheel"><circle cx="104" cy="58" r="10" fill="#14232a" /><circle cx="104" cy="58" r="4.5" fill="#d9d9d9" /><path d="M104 53.5v9M99.5 58h9" stroke="#14232a" stroke-width="1.6" /></g>
        </g>
      </g>
    </g>
  </g>
</svg>
</div>
