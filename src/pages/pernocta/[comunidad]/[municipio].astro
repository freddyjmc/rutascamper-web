---
import Base from "../../../layouts/Base.astro";
import FotoDestino from "../../../components/FotoDestino.astro";
import Ficha from "../../../components/Ficha.astro";
import { getCollection, getEntry } from "astro:content";
import { visible } from "../../../site";

export async function getStaticPaths() {
  const all = (await getCollection("municipios")).filter(visible);
  return all.map((m) => ({
    params: { comunidad: m.data.comunidad, municipio: m.id.split("/").pop() },
    props: { m },
  }));
}

const { m } = Astro.props;
const c = await getEntry("comunidades", m.data.comunidad);
const cNombre = c?.data.nombre ?? m.data.comunidad;
const slug = m.id.split("/").pop()!;
const title = `¿Se puede dormir con camper en ${m.data.nombre}?`;
const description = `${m.data.resumen.slice(0, 150)}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  inLanguage: "es",
  dateModified: m.data.revisado?.toISOString(),
  about: { "@type": "Place", name: `${m.data.nombre}, ${m.data.provincia}` },
};

// Minimapa estático: teselas OSM de zoom 14 (fórmula "slippy map"), calculadas en el build.
const Z = 14;
const idx = m.data.areas.findIndex((a: any) => a.lat !== undefined && a.lon !== undefined);
const area = idx >= 0 ? m.data.areas[idx] : undefined;
let mini: { tiles: { x: number; y: number }[]; px: number; py: number } | undefined;
if (area) {
  const n = 2 ** Z;
  const rad = (area.lat * Math.PI) / 180;
  const xf = ((area.lon + 180) / 360) * n;
  const yf = ((1 - Math.log(Math.tan(rad) + 1 / Math.cos(rad)) / Math.PI) / 2) * n;
  // Rejilla 2×2 que arranca media tesela antes del punto: el punto queda entre 128 y 384 px.
  const x0 = Math.floor(xf - 0.5);
  const y0 = Math.floor(yf - 0.5);
  mini = {
    tiles: [0, 1].flatMap((dy) => [0, 1].map((dx) => ({ x: x0 + dx, y: y0 + dy }))),
    px: Math.round((xf - x0) * 256),
    py: Math.round((yf - y0) * 256),
  };
}
// Primera área que puede ir a «Mi ruta» (mismo criterio que el mapa).
const rutaIdx = m.data.areas.findIndex((a: any) => a.lat !== undefined && a.lon !== undefined && a.coordFuente);
const rutaArea = rutaIdx >= 0 ? m.data.areas[rutaIdx] : undefined;
---
<Base
  title={title}
  description={description}
  noindex={!m.data.verificado}
  schema={schema}
  crumbs={[
    { name: "Destinos", href: "/destinos/" },
    { name: "España", href: "/pernocta/" },
    { name: cNombre, href: `/pernocta/${m.data.comunidad}/` },
    { name: m.data.nombre, href: Astro.url.pathname },
  ]}
>
  <div class="ficha-page">
    <h1>¿Se puede dormir con camper en {m.data.nombre}?</h1>
    <div class="ficha-layout">
      <div class="ficha-main">
        <FotoDestino id={`municipios/${m.data.comunidad}/${slug}`} />
        <Ficha m={m.data} slug={slug} />
        <p class="ficha-nav"><a href={`/pernocta/${m.data.comunidad}/`}>← Normativa en {cNombre}</a> · <a href="/puedo-dormir-aqui/">Buscar otro municipio</a></p>
      </div>
      <aside class="ficha-side" aria-label="Mapa y acciones">
        {mini && area && (
          <section class="mini" aria-labelledby="mini-titulo">
            <h2 id="mini-titulo">Dónde está</h2>
            <div class="mini-box">
              <div class="mini-grid" style={`left: calc(50% - ${mini.px}px); top: calc(50% - ${mini.py}px);`}>
                {mini.tiles.map((t, i) => (
                  <img src={`https://tile.openstreetmap.org/${Z}/${t.x}/${t.y}.png`} width="256" height="256" loading="lazy" decoding="async" alt={i === 0 ? `Mapa de la zona de ${area.nombre}` : ""} />
                ))}
              </div>
              <span class="mini-pin" aria-hidden="true"></span>
            </div>
            <p class="mini-attr"><a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">© OpenStreetMap</a></p>
            {area.coordTipo === "aproximada" && <p class="meta mini-aprox">Ubicación aproximada</p>}
            <p class="mini-links">
              <a href={`/mapa-areas-autocaravanas/#${slug}-${idx + 1}`}>Ver en el mapa</a>
              <a href={`https://www.openstreetmap.org/directions?to=${area.lat},${area.lon}`} rel="noopener" target="_blank">{area.coordTipo === "aproximada" ? "Cómo llegar (ubicación aproximada) ↗" : "Cómo llegar ↗"}</a>
            </p>
          </section>
        )}
        <div class="acciones" data-slug={slug} data-nombre={m.data.nombre} data-comunidad={cNombre} data-url={Astro.url.pathname}>
          <button type="button" class="act act-guardar" aria-pressed="false" hidden>
            <span class="act-txt">Guardar</span>
          </button>
          <button type="button" class="act act-visitado" aria-pressed="false" hidden>
            <span class="act-txt">Lo he visitado</span>
          </button>
          {rutaArea && (
            <button type="button" class="act act-ruta" data-ruta-id={`${slug}-${rutaIdx + 1}`} data-ruta-nombre={rutaArea.nombre} aria-pressed="false" hidden>
              <span class="ruta-txt">Añadir a mi ruta</span><span class="sr-only">: {rutaArea.nombre}</span>
            </button>
          )}
          <button type="button" class="act act-compartir" hidden>Compartir</button>
          <button type="button" class="act act-imprimir">Imprimir</button>
          <p class="sr-only" role="status" aria-live="polite" id="acc-aviso"></p>
          <p class="meta acc-aviso-vis" aria-hidden="true" id="acc-aviso-vis"></p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { KEYS, getFichas, escribir, getRuta, alternaRuta, alCambiarRuta, pintaBotonRuta } from "../../../scripts/rc";

  const box = document.querySelector<HTMLElement>(".acciones");
  if (box) {
    const aviso = document.getElementById("acc-aviso")!;
    const avisoVis = document.getElementById("acc-aviso-vis")!;
    const say = (t: string) => {
      aviso.textContent = "";
      requestAnimationFrame(() => { aviso.textContent = t; });
      avisoVis.textContent = t;
      setTimeout(() => { avisoVis.textContent = ""; }, 3500);
    };
    const { slug = "", nombre = "", comunidad = "", url = "" } = box.dataset;
    const ficha = { slug, nombre, comunidad, url };
    const guardar = box.querySelector<HTMLButtonElement>(".act-guardar")!;
    const visitado = box.querySelector<HTMLButtonElement>(".act-visitado")!;
    const compartir = box.querySelector<HTMLButtonElement>(".act-compartir")!;
    const imprimir = box.querySelector<HTMLButtonElement>(".act-imprimir")!;

    // «Guardar» y «Lo he visitado» comparten lógica: alternan la ficha en su lista, solo al pulsar.
    const alternador = (btn: HTMLButtonElement, key: string, textos: { on?: string; ponLabel: boolean; sayOn: string; sayOff: string }) => {
      const pintar = (on: boolean) => {
        btn.setAttribute("aria-pressed", String(on));
        if (textos.ponLabel) btn.querySelector(".act-txt")!.textContent = on ? textos.on! : btn.dataset.off!;
      };
      btn.dataset.off = btn.querySelector(".act-txt")!.textContent!;
      pintar(getFichas(key).some((x) => x.slug === slug));
      btn.hidden = false;
      btn.addEventListener("click", () => {
        const lista = getFichas(key);
        const ya = lista.some((x) => x.slug === slug);
        const nueva = ya ? lista.filter((x) => x.slug !== slug) : [...lista, ficha];
        if (escribir(key, nueva)) { pintar(!ya); say(ya ? textos.sayOff : textos.sayOn); }
        else say("No se ha podido guardar: tu navegador bloquea el almacenamiento local");
      });
    };
    alternador(guardar, KEYS.guardados, { on: "Guardada", ponLabel: true, sayOn: "Ficha guardada en este navegador", sayOff: "Ficha quitada de guardados" });
    alternador(visitado, KEYS.visitados, { ponLabel: false, sayOn: "Marcado como visitado en este navegador", sayOff: "Ya no está marcado como visitado" });

    compartir.hidden = false;
    compartir.addEventListener("click", async () => {
      const enlace = location.origin + url;
      if (navigator.share) {
        try { await navigator.share({ title: document.title, url: enlace }); } catch { /* cancelado */ }
        return;
      }
      try { await navigator.clipboard.writeText(enlace); say("Enlace copiado"); }
      catch { say("No se ha podido copiar el enlace"); }
    });

    imprimir.addEventListener("click", () => window.print());
  }

  // «Añadir a mi ruta»: uno por área con coordenadas. Se guarda solo al pulsar.
  const botonesRuta = [...document.querySelectorAll<HTMLButtonElement>("[data-ruta-id]")];
  if (botonesRuta.length) {
    const aviso = document.getElementById("acc-aviso");
    const avisoVis = document.getElementById("acc-aviso-vis");
    const pintaTodos = () => {
      const ruta = getRuta();
      botonesRuta.forEach((b) => pintaBotonRuta(b, ruta.includes(b.dataset.rutaId!)));
    };
    pintaTodos();
    botonesRuta.forEach((b) => {
      b.hidden = false;
      b.addEventListener("click", () => {
        const r = alternaRuta(b.dataset.rutaId!);
        pintaTodos();
        const t = !r.ok
          ? "No se ha podido guardar: tu navegador bloquea el almacenamiento local"
          : r.enRuta ? `${b.dataset.rutaNombre} añadida a tu ruta (${r.n} ${r.n === 1 ? "parada" : "paradas"})` : `${b.dataset.rutaNombre} quitada de tu ruta`;
        if (aviso) { aviso.textContent = ""; requestAnimationFrame(() => { aviso.textContent = t; }); }
        if (avisoVis) { avisoVis.textContent = t; setTimeout(() => { avisoVis.textContent = ""; }, 3500); }
      });
    });
    alCambiarRuta(pintaTodos);
  }
</script>
