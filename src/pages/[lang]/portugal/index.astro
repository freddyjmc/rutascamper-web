---
import Portugal from "../../../views/Portugal.astro";
import { getEntry } from "astro:content";
import { langParams, type Lang } from "../../../i18n";
import { visibleFr } from "../../../site";
// Sin guía nacional publicada (verificada), /portugal/ no se genera en ningún idioma.
export async function getStaticPaths() {
  const nac = await getEntry("nacionalPt", "nacional");
  return nac && visibleFr(nac) ? langParams() : [];
}
const lang = Astro.params.lang as Lang;
---
<Portugal lang={lang} />
